@model Category
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Удаление категории"; }
<div class="card">
    <h3 style="color: #dc2626; margin-bottom: 15px;">Удалить категорию "@Model.Name"?</h3>
    <p>Товары этой категории останутся в базе, но потеряют привязку.</p>
    <hr style="margin: 20px 0; border: none; border-top: 1px solid #e2e8f0;" />
    <form method="post" action="/Admin/Categories/Delete/@Model.Id">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-danger">Да, удалить</button>
        <a href="/Admin/Categories" class="btn btn-outline">Отмена</a>
    </form>
</div>