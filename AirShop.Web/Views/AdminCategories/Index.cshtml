@model IEnumerable<Category>
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Категории"; }

<div style="display: flex; justify-content: space-between; margin-bottom: 20px;">
    <h2>Список категорий</h2>
    <a href="/Admin/Categories/Create" class="btn btn-primary">+ Добавить</a>
</div>
<div class="table-wrapper">
    <table>
        <thead><tr><th>ID</th><th>Название</th><th>Описание</th><th>Действия</th></tr></thead>
        <tbody>
            @foreach (var item in Model) {
                <tr>
                    <td>@item.Id</td><td>@item.Name</td><td>@item.Description</td>
                    <td>
                        <a href="/Admin/Categories/Edit/@item.Id" class="btn btn-outline btn-sm">Изменить</a>
                        <a href="/Admin/Categories/Delete/@item.Id" class="btn btn-danger btn-sm">Удалить</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>