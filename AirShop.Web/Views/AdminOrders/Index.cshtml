@model IEnumerable<Order>
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Заказы"; }
<div class="table-wrapper">
    <table>
        <thead><tr><th>№</th><th>Клиент</th><th>Сумма</th><th>Статус</th><th>Дата</th><th>Действия</th></tr></thead>
        <tbody>
            @foreach (var item in Model) {
                <tr>
                    <td>@item.Id</td>
                    <td>@(item.User?.Login ?? "—")</td>
                    <td>@item.TotalAmount.ToString("N0") ₽</td>
                    <td><span style="padding: 4px 8px; background: #e2e8f0; border-radius: 4px; font-size: 0.85rem;">@item.Status</span></td>
                    <td>@item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>
                        <a href="/Admin/Orders/Edit/@item.Id" class="btn btn-outline btn-sm">Статус</a>
                        <a href="/Admin/Orders/Delete/@item.Id" class="btn btn-danger btn-sm">Удалить</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>