@model User
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Пользователь"; }
<div class="card">
    <form method="post" action="/Admin/Users/Edit/@Model.Id + hidden Id">
        @Html.AntiForgeryToken()
        <div class="form-group"><label>Логин</label><input type="text" name="Login" class="form-control" value="@Model.Login" required /></div>
        <div class="form-group"><label>Email</label><input type="email" name="Email" class="form-control" value="@Model.Email" /></div>
        <div class="form-group"><label>Хеш пароля</label><input type="text" name="PasswordHash" class="form-control" value="@Model.PasswordHash" required /></div>
        <div class="form-group">
            <label>Роль</label>
            <select name="RoleId" class="form-control" asp-items="ViewBag.Roles"></select>
        </div>
        <div class="form-group">
            <label><input type="checkbox" name="IsActive" value="true" @(Model.IsActive ? "checked" : "") /> Активен</label>
            <input type="hidden" name="IsActive" value="false" /> <!-- Чтобы при снятии галочки отправлялся false -->
        </div>
        <button type="submit" class="btn btn-primary">Сохранить</button>
        <a href="/Admin/Users" class="btn btn-outline">Отмена</a>
    </form>
</div>