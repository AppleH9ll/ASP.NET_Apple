@model IEnumerable<Product>
@{
    ViewData["Title"] = "Каталог";
    var categories = (List<Category>)ViewBag.Categories;
    int? selected = ViewBag.SelectedCategory as int?;
    string? search = ViewBag.Search as string;
    string? sortOrder = ViewBag.SortOrder as string;
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
}

<section class="hero">
    <h1>Свежий воздух со всего мира</h1>
    <p>Альпы, Байкал, Средиземноморье — доставим в герметичной упаковке.</p>
</section>

<form method="get" class="filters" style="display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 25px;">
    <input type="search" name="search" value="@search" placeholder="Поиск по названию…" class="form-control" style="flex: 1; min-width: 200px; padding: 10px; border-radius: 8px; border: 1px solid #cbd5e1;" />
    
    <select name="categoryId" class="form-control" style="padding: 10px; border-radius: 8px; border: 1px solid #cbd5e1;">
        <option value="">Все категории</option>
        @foreach (var c in categories)
        {
            <option value="@c.Id" selected="@(selected == c.Id)">@c.Name</option>
        }
    </select>
    
    <select name="sortOrder" class="form-control" style="padding: 10px; border-radius: 8px; border: 1px solid #cbd5e1;">
        <option value="name_asc" selected="@(sortOrder == "name_asc" || sortOrder == null)">Название (А-Я)</option>
        <option value="name_desc" selected="@(sortOrder == "name_desc")">Название (Я-А)</option>
        <option value="price_asc" selected="@(sortOrder == "price_asc")">Цена (по возрастанию)</option>
        <option value="price_desc" selected="@(sortOrder == "price_desc")">Цена (по убыванию)</option>
    </select>
    
    <button type="submit" class="btn btn-primary" style="padding: 10px 20px;">Применить</button>
</form>

@if (!Model.Any())
{
    <div class="empty">
        <p>Ничего не нашлось. Попробуйте другой фильтр или поисковый запрос.</p>
    </div>
}
else
{
    <div class="product-grid">
        @foreach (var p in Model)
        {
            <article class="card" style="padding: 0; overflow: hidden; display: flex; flex-direction: column;">
                <!-- Блок с изображением -->
                <div style="width: 100%; height: 220px; background: #f8fafc; display: flex; align-items: center; justify-content: center; overflow: hidden; border-bottom: 1px solid var(--border);">
                    @if (!string.IsNullOrEmpty(p.ImageUrl))
                    {
                        <img src="@p.ImageUrl" alt="@p.Name" style="max-width: 100%; max-height: 100%; object-fit: contain; padding: 10px;" />
                    }
                    else
                    {
                        <span style="color: #64748b;">Нет фото</span>
                    }
                </div>
                
                <!-- Текстовое содержимое карточки -->
                <div style="padding: 1.25rem; display: flex; flex-direction: column; flex: 1;">
                    <div class="card-badge">@p.Category?.Name</div>
                    <h2 class="card-title" style="margin-top: 10px;">@p.Name</h2>
                    <p class="card-desc">@p.Description</p>
                    
                    <div class="card-footer" style="margin-top: auto; padding-top: 15px; border-top: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center;">
                        <span class="price">@p.Price.ToString("N0") ₽</span>
                        <form asp-controller="Cart" asp-action="Add" method="post" style="margin: 0;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" value="@p.Id" />
                            <!-- Сохраняем текущие параметры фильтра, чтобы после добавления остаться на этой же странице -->
                            <input type="hidden" name="returnUrl" value="@Url.Action("Index", "Catalog", new { search, categoryId = selected, sortOrder, page = currentPage })" />
                            <button type="submit" class="btn btn-primary">В корзину</button>
                        </form>
                    </div>
                </div>
            </article>
        }
    </div>

    <!-- Пагинация -->
    @if (totalPages > 1)
    {
        <div style="display: flex; justify-content: center; gap: 8px; margin-top: 40px; flex-wrap: wrap;">
            @for (int i = 1; i <= totalPages; i++)
            {
                <a href="@Url.Action("Index", new { search, categoryId = selected, sortOrder, page = i })" 
                   class="btn @(i == currentPage ? "btn-primary" : "btn-outline")"
                   style="min-width: 40px; text-align: center; padding: 8px 12px;">
                    @i
                </a>
            }
        </div>
    }
}