@model Product
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Создание товара";
}

<div class="card">
    <div asp-validation-summary="All" style="color: #dc2626; margin-bottom: 15px; font-weight: 500;"></div>

    <!-- Обязательно enctype="multipart/form-data" для загрузки файлов -->
    <form method="post" action="/Admin/Products/Create" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        
        <div class="form-group">
            <label>Название</label>
            <input type="text" name="Name" class="form-control" value="@Model.Name" />
            <span asp-validation-for="Name" style="color: #dc2626; font-size: 0.85rem; margin-top: 5px; display: block;"></span>
        </div>

        <div class="form-group">
            <label>Категория</label>
            <select name="CategoryId" class="form-control" asp-items="ViewBag.Categories">
                <option value="">Без категории</option>
            </select>
        </div>

        <div class="form-group">
            <label>Цена (₽)</label>
            <input type="number" step="0.01" name="Price" class="form-control" value="@Model.Price" />
            <span asp-validation-for="Price" style="color: #dc2626; font-size: 0.85rem; margin-top: 5px; display: block;"></span>
        </div>

        <div class="form-group">
            <label>Остаток на складе (кратно 5)</label>
            <input type="number" name="Stock" class="form-control" value="@Model.Stock" />
            <span asp-validation-for="Stock" style="color: #dc2626; font-size: 0.85rem; margin-top: 5px; display: block;"></span>
        </div>

        <div class="form-group">
            <label>Объем (литры)</label>
            <input type="number" step="0.01" name="VolumeLiters" class="form-control" value="@Model.VolumeLiters" />
            <span asp-validation-for="VolumeLiters" style="color: #dc2626; font-size: 0.85rem; margin-top: 5px; display: block;"></span>
        </div>

        <div class="form-group">
            <label>Регион происхождения</label>
            <input type="text" name="OriginRegion" class="form-control" value="@Model.OriginRegion" />
        </div>

        <div class="form-group">
            <label>Описание</label>
            <textarea name="Description" class="form-control" rows="4">@Model.Description</textarea>
            <span asp-validation-for="Description" style="color: #dc2626; font-size: 0.85rem; margin-top: 5px; display: block;"></span>
        </div>

        <!-- ЗАГРУЗКА ИЗОБРАЖЕНИЯ -->
        <div class="form-group">
            <label>Изображение товара (файл)</label>
            <input type="file" name="ImageFile" class="form-control" accept="image/*" />
        </div>

        <button type="submit" class="btn btn-primary">Сохранить</button>
        <a href="/Admin/Products" class="btn btn-outline">Отмена</a>
    </form>
</div>