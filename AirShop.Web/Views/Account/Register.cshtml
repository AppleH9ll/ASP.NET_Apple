@{
    Layout = "_Layout";
    ViewData["Title"] = "Регистрация";
}

<div class="container" style="max-width: 400px; margin-top: 50px;">
    <div class="card" style="padding: 30px;">
        <h2 style="margin-bottom: 20px; text-align: center;">Регистрация</h2>
        
        @if (ViewBag.Error != null)
        {
            <div style="background: #fee2e2; color: #dc2626; padding: 10px; border-radius: 8px; margin-bottom: 15px; text-align: center;">
                @ViewBag.Error
            </div>
        }

        <form method="post">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label>Логин</label>
                <input type="text" name="login" class="form-control" required />
            </div>
            <div class="form-group">
                <label>Ваше Имя</label>
                <input type="text" name="fullName" class="form-control" />
            </div>
            <div class="form-group">
                <label>Пароль</label>
                <input type="password" name="password" class="form-control" required />
            </div>
            <button type="submit" class="btn btn-primary" style="width: 100%;">Создать аккаунт</button>
        </form>
        <p style="text-align: center; margin-top: 15px; font-size: 0.9rem;">
            Уже есть аккаунт? <a href="/Account/Login" style="color: #2563eb;">Войти</a>
        </p>
    </div>
</div>