@{
    Layout = "_Layout";
    ViewData["Title"] = "Заказ оформлен";
}
<div class="container" style="text-align: center; margin-top: 50px; background: white; padding: 40px; border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.05);">
    <h1 style="color: #16a34a;">🎉 Заказ успешно оформлен!</h1>
    <p style="font-size: 1.2rem; margin-top: 20px;">Номер вашего заказа: <strong>#@ViewBag.OrderId</strong></p>
    <p style="color: #64748b; margin-top: 10px;">Менеджер свяжется с вами в ближайшее время.</p>
    <a href="/Catalog" class="btn btn-primary" style="margin-top: 20px;">Вернуться в каталог</a>
</div>