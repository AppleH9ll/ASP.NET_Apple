@model Cart
@{
    ViewData["Title"] = "Корзина";
    var total = Model.Items.Sum(i => i.LineTotal);
    var totalCount = Model.Items.Sum(i => i.Quantity);
}

<h1 class="page-title">Корзина</h1>

<!-- Блок вывода ошибки -->
@if (TempData["Error"] != null)
{
    <div style="background: #fee2e2; color: #dc2626; padding: 15px; border-radius: 8px; margin-bottom: 20px; font-weight: 500;">
        @TempData["Error"]
    </div>
}

@if (!Model.Items.Any())
{
    <div class="empty">
        <p>Корзина пуста.</p>
        <a asp-controller="Catalog" asp-action="Index" class="btn btn-primary">Перейти в каталог</a>
    </div>
}
else
{
    <table class="cart-table">
        <thead>
            <tr>
                <th>Товар</th>
                <th>Цена</th>
                <th>Количество</th>
                <th>Сумма</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>
                        <div class="cart-product">
                            <strong>@item.Product.Name</strong>
                            <small>@item.Product.Category?.Name · @item.Product.OriginRegion</small>
                        </div>
                    </td>
                    <td>@item.Product.Price.ToString("N0") ₽</td>
                    <td>
                        <form asp-action="Update" method="post" class="qty-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="itemId" value="@item.Id" />
                            <input type="number" name="quantity" min="1" value="@item.Quantity" />
                            <button type="submit" class="btn btn-ghost">↻</button>
                        </form>
                    </td>
                    <td class="line-total">@item.LineTotal.ToString("N0") ₽</td>
                    <td>
                        <form asp-action="Remove" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="itemId" value="@item.Id" />
                            <button type="submit" class="btn btn-danger">Удалить</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="cart-summary" style="display: flex; justify-content: space-between; align-items: center; margin-top: 20px; background: white; padding: 20px; border-radius: 10px; box-shadow: 0 4px 6px rgba(0,0,0,0.05);">
        <div style="font-size: 1.1rem;">Товаров: <strong>@totalCount</strong></div>
        <div class="cart-total" style="font-size: 1.2rem;">Итого: <strong style="color: #2563eb;">@total.ToString("N0") ₽</strong></div>
        
        <!-- Кнопка оформления -->
        <form method="post" asp-action="Checkout" style="margin: 0;">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-primary" style="font-size: 1rem; padding: 12px 24px;">Оформить заказ</button>
        </form>
    </div>
}