@inject AirShop.Web.Data.AppDbContext Db
@{
    var cartCount = Db.CartItems
        .Where(ci => ci.Cart.UserId == 2)
        .Sum(ci => (int?)ci.Quantity) ?? 0;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — AirShop</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header class="site-header">
        <div class="container header-inner">
            <a class="brand" asp-controller="Catalog" asp-action="Index">
                <span class="brand-mark">Air</span>Shop
            </a>
            <nav class="nav">
                <a asp-controller="Catalog" asp-action="Index">Каталог</a>
                <a asp-controller="Cart" asp-action="Index" class="cart-link">
                    Корзина
                    @if (cartCount > 0)
                    {
                        <span class="badge">@cartCount</span>
                    }
                </a>
            </nav>
        </div>
    </header>

    <main class="container main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">© @DateTime.Now.Year — магазин свежего воздуха</div>
    </footer>
</body>
</html>